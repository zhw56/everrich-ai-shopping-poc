{
  "name": "@everrich-demo/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test:tools": "tsx scripts/test-tools.ts",
    "chat": "tsx scripts/chat.ts",
    "eval": "tsx scripts/eval.ts",
    "eval:demo": "tsx scripts/eval.ts --demo",
    "test:comparison": "tsx --test scripts/test-comparison.ts",
    "test:admin": "tsx --test scripts/test-admin.ts",
    "test:edit": "tsx --test scripts/test-edit.ts",
    "replay": "tsx scripts/replay.ts",
    "test:profile": "PROFILE_PERSIST=0 tsx --test scripts/test-profile.ts",
    "test:llm": "tsx --test scripts/test-llm.ts",
    "smoke": "PROFILE_PERSIST=0 tsx scripts/smoke.ts",
    "timing": "PROFILE_PERSIST=0 tsx scripts/timing.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "opencc-js": "^1.4.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.23.15"
  }
}
